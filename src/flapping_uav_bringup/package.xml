<?xml version="1.0"?>
<package format="3">
  <name>flapping_uav_bringup</name>
  <version>0.1.0</version>
  <description>Launch files, hardware configuration and RViz scenes for the flapping UAV ground station.</description>
  <maintainer email="maintainer@example.com">Flapping UAV Maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>flapping_uav_gcs</exec_depend>
  <exec_depend>flapping_uav_msgs</exec_depend>
  <exec_depend>nlink_parser2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>joy</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
